# Everything runs locally by default; these only change which local models are used.
# Grading model: any OpenAI-compatible chat server (llama-swap / llama-server / Ollama).
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gpt-oss-20b
# Leave empty for a local server.
LLM_API_KEY=
# faster-whisper model: tiny, base, small, medium
WHISPER_MODEL=base
# CPU threads for Whisper; more than ~4 slows it down when other programs are busy
WHISPER_THREADS=4
# Seconds to wait for a follow-up question before the interview moves on
FOLLOW_UP_TIMEOUT_S=45
# Vision model for the opt-in camera-setup check (needs an mmproj; see README)
VISION_MODEL=qwen2.5-vl-3b
# The standalone ans_eval/ tool still uses Groq (comma-separated keys).
GROQ_API_KEYS=
